PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/taskspot
JWT_SECRET=replace_with_long_random_secret
# Local development:
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Production:
# CLIENT_URL=https://taskspot.ru
# CORS_ORIGINS=https://taskspot.ru,https://www.taskspot.ru

# Optional: required for email confirmation, invitations and notifications.
# For Timeweb Cloud mailbox use smtp.timeweb.ru.
# The backend tries SMTP_PORTS in order. For Timeweb keep all three ports
# because available outgoing ports can differ between plans and networks.
SMTP_HOST=smtp.timeweb.ru
SMTP_PORT=465
SMTP_FALLBACK_PORT=2525
SMTP_PORTS=465,587,2525
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=no-reply@taskspot.ru
SMTP_PASS=
SMTP_FROM="Taskspot <no-reply@taskspot.ru>"
SMTP_CONNECTION_TIMEOUT_MS=8000
SMTP_GREETING_TIMEOUT_MS=8000
SMTP_SOCKET_TIMEOUT_MS=12000

# Optional: S3-compatible object storage for task attachments.
# For Timeweb Cloud Object Storage use values from bucket/access keys settings.
S3_ENDPOINT=https://s3.twcstorage.ru
S3_REGION=ru-1
S3_BUCKET=taskspot-bucket
S3_ACCESS_KEY_ID=replace_with_access_key
S3_SECRET_ACCESS_KEY=replace_with_secret_key
S3_MAX_FILE_SIZE_MB=20

# Billing. In production Tochka is selected automatically when its required
# values are present. BILLING_PROVIDER can explicitly select mock or tochka_sbp.
BILLING_PROVIDER=tochka_sbp
TOCHKA_API_URL=https://enter.tochka.com/uapi
TOCHKA_JWT_TOKEN=
TOCHKA_CLIENT_ID=
TOCHKA_MERCHANT_ID=
TOCHKA_LEGAL_ID=
# Either use accountId in settlement_account/BIC format or provide BIC separately.
TOCHKA_ACCOUNT_ID=
TOCHKA_BIC=
# Optional PEM key override. Without it the current JWK is loaded from Tochka.
TOCHKA_WEBHOOK_PUBLIC_KEY=
TOCHKA_WEBHOOK_PUBLIC_KEY_URL=https://enter.tochka.com/doc/openapi/static/keys/public
BILLING_WEBHOOK_URL=https://api.taskspot.ru/api/webhooks/tochka/sbp

# DigitalKassa fiscal receipts. Credentials are used as HTTP Basic Auth.
DIGITALKASSA_API_URL=https://api.digitalkassa.ru/v2.1
DIGITALKASSA_ACTOR_ID=
DIGITALKASSA_ACTOR_TOKEN=
DIGITALKASSA_C_GROUP_ID=
DIGITALKASSA_BILLING_PLACE=https://taskspot.ru
# Automatic DigitalKassa retries run every five minutes and stop at this limit.
FISCALIZATION_MAX_ATTEMPTS=12

# Explicit opt-in values for `npm run billing:check:live`.
# The command creates a real paid QR and issues a real control receipt after payment.
BILLING_CHECK_LIVE_CONFIRM=NO
BILLING_CHECK_AMOUNT_KOPECKS=100
BILLING_CHECK_RECEIPT_EMAIL=
BILLING_CHECK_WAIT_MINUTES=10
BILLING_CHECK_PLAN_NAME="Команда (контрольная оплата)"

# Optional: used by `npm test`.
# Use a separate database. Tests create and drop a generated test database.
TEST_MONGODB_URI=mongodb://127.0.0.1:27017/taskspot_test

# Persistent email queue and recurrence/reminder worker run inside backend.
## Durable email outbox and queue: keep at least one backend worker enabled.
## Read-only diagnostics: npm run email:queue
BACKGROUND_WORKERS_ENABLED=true
EMAIL_MAX_ATTEMPTS=8
TASK_TIME_ZONE=Europe/Moscow
# Deliver queued mobile notifications through the Expo Push API.
EXPO_PUSH_ENABLED=true

# One-off admin provisioning; do not keep ADMIN_PASSWORD in the running service.
# Set these as temporary server-side environment variables, never VITE_*.
# Existing superadmin: npm run admin:setup -- --rotate-password
# Existing superadmin with a temporary password that must be replaced in Profile:
# npm run admin:setup -- --rotate-password --temporary-password
# Existing regular account: npm run admin:setup -- --promote
# New account: npm run admin:setup
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
