PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/taskspot
JWT_SECRET=replace_with_long_random_secret
# Local development:
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Production:
# CLIENT_URL=https://taskspot.ru
# CORS_ORIGINS=https://taskspot.ru,https://www.taskspot.ru

# Optional: required for email confirmation, invitations and notifications.
# For Timeweb Cloud mailbox use smtp.timeweb.ru.
# The backend tries SMTP_PORTS in order. For Timeweb keep all three ports
# because available outgoing ports can differ between plans and networks.
SMTP_HOST=smtp.timeweb.ru
SMTP_PORT=465
SMTP_FALLBACK_PORT=2525
SMTP_PORTS=465,587,2525
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=no-reply@taskspot.ru
SMTP_PASS=
SMTP_FROM="Taskspot <no-reply@taskspot.ru>"
SMTP_CONNECTION_TIMEOUT_MS=8000
SMTP_GREETING_TIMEOUT_MS=8000
SMTP_SOCKET_TIMEOUT_MS=12000

# Optional: S3-compatible object storage for task attachments.
# For Timeweb Cloud Object Storage use values from bucket/access keys settings.
S3_ENDPOINT=https://s3.twcstorage.ru
S3_REGION=ru-1
S3_BUCKET=taskspot-bucket
S3_ACCESS_KEY_ID=replace_with_access_key
S3_SECRET_ACCESS_KEY=replace_with_secret_key
S3_MAX_FILE_SIZE_MB=20

# Optional future billing providers. Billing light works without these values:
# users create tariff requests, super admin enables plans manually.
DIGITALKASSA_API_URL=
DIGITALKASSA_SHOP_ID=
DIGITALKASSA_API_KEY=
DIGITALKASSA_WEBHOOK_SECRET=
TOCHKA_API_URL=
TOCHKA_CLIENT_ID=
TOCHKA_CLIENT_SECRET=
TOCHKA_WEBHOOK_SECRET=

# Optional: used by `npm test`.
# Use a separate database. Tests create and drop a generated test database.
TEST_MONGODB_URI=mongodb://127.0.0.1:27017/taskspot_test

# Persistent email queue and recurrence/reminder worker run inside backend.
## Durable email outbox and queue: keep at least one backend worker enabled.
## Read-only diagnostics: npm run email:queue
BACKGROUND_WORKERS_ENABLED=true
EMAIL_MAX_ATTEMPTS=8
TASK_TIME_ZONE=Europe/Moscow

# One-off admin provisioning; do not keep ADMIN_PASSWORD in the running service.
# Set these as temporary server-side environment variables, never VITE_*.
# Existing superadmin: npm run admin:setup -- --rotate-password
# Existing regular account: npm run admin:setup -- --promote
# New account: npm run admin:setup
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
