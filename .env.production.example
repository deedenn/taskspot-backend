NODE_ENV=production
PORT=4000
MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST.mongodb.net/taskspot?retryWrites=true&w=majority&appName=Cluster0
JWT_SECRET=replace_with_a_long_random_secret
CLIENT_URL=https://taskspot.ru
CORS_ORIGINS=https://taskspot.ru,https://www.taskspot.ru

# Optional: required only for automatic email invitations.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=mailbox@example.com
SMTP_PASS=mailbox_password
SMTP_FROM="Taskspot <mailbox@example.com>"
