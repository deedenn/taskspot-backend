NODE_ENV=production
PORT=4000
MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST.mongodb.net/taskspot?retryWrites=true&w=majority&appName=Cluster0
JWT_SECRET=replace_with_a_long_random_secret
CLIENT_URL=https://taskspot.ru
CORS_ORIGINS=https://taskspot.ru,https://www.taskspot.ru

# Optional: required only for automatic email invitations.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=mailbox@example.com
SMTP_PASS=mailbox_password
SMTP_FROM="Taskspot <mailbox@example.com>"

# S3-compatible object storage for task attachments.
S3_ENDPOINT=https://s3.twcstorage.ru
S3_REGION=ru-1
S3_BUCKET=taskspot-bucket
S3_ACCESS_KEY_ID=replace_with_access_key
S3_SECRET_ACCESS_KEY=replace_with_secret_key
S3_MAX_FILE_SIZE_MB=20
